<?php
ob_start();
session_name('NEYDREAM_SESSION');
session_set_cookie_params([
    'lifetime' => 0,
    'path' => '/',
    'domain' => '',
    'secure' => false,
    'httponly' => true,
    'samesite' => 'Lax'
]);
session_start();

$host = 'localhost';
$user = 'root';
$pass = ''; // Sesuaikan dengan password database Anda
$db   = 'neydream_db';

$conn = new mysqli($host, $user, $pass, $db);

if ($conn->connect_error) {
    die("Connection failed: " . $conn->connect_error);
}
?>
